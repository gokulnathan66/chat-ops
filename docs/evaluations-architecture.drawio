        <mxCell id="lambda_pca" value="Lambda&#xa;pca-runner&#xa;pca.py&#xa;timeout=300s · mem=512MB"
          style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;"
          vertex="1" parent="1">
          <mxGeometry x="974" y="285" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="pca_detail" value="&lt;b&gt;pca.py — per stale session (inactive &gt; 15min):&lt;/b&gt;&lt;br&gt;1. Query conversations_table GSI (status=active)&lt;br&gt;2. Mark session complete&lt;br&gt;3. Bedrock structured output → topics + sentiment&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ unresolved_questions (PCA_SCHEMA)&lt;br&gt;4. Write: eval#pca#ts to evaluations_table&lt;br&gt;5. Sliding-window degradation check (PCA_DEGRADATION_WINDOW)&lt;br&gt;6. If degraded: write alert to hitl_table + eval table"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;"
          vertex="1" parent="1">
          <mxGeometry x="838" y="410" width="345" height="150" as="geometry"/>
        </mxCell>

